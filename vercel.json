{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ],
  "env": {
    "OPENWEATHER_API_KEY": "@openweather_api_key",
    "COINGECKO_API_KEY": "@coingecko_api_key",
    "TWITTER_BEARER_TOKEN": "@twitter_bearer_token",
    "ORACLE_SIGNING_SECRET": "@oracle_signing_secret"
  }
}
