{
  "version": 2,
  "rewrites": [
    { "source": "/api/weather", "destination": "/api/weather.js" },
    { "source": "/api/price",   "destination": "/api/price.js"   },
    { "source": "/api/social",  "destination": "/api/social.js"  },
    { "source": "/api/verify",  "destination": "/api/verify.js"  },
    { "source": "/(.*)",        "destination": "/public/index.html" }
  ]
}
