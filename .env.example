# ─── IC API Gateway — Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in your real API keys
# NEVER commit .env to git — it's already in .gitignore

# OpenWeatherMap (free tier works)
# Get key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_key_here

# CoinGecko (free tier, no key needed for basic — optional for pro)
# Get key at: https://www.coingecko.com/en/api
COINGECKO_API_KEY=your_coingecko_key_here

# Twitter/X API v2 Bearer Token
# Get at: https://developer.twitter.com/en/portal
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Oracle signing secret — any random 32+ char string
# Used to sign all proxy responses (Ed25519-style HMAC)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORACLE_SIGNING_SECRET=generate_a_random_secret_here

# Port for local dev
PORT=3000
